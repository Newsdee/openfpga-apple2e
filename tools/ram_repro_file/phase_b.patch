# Phase B patch: file-based RAM zero-init (TASK_RAM_FILE_INITIALIZATION, 2026-10-25)
# Files: src/fpga/core/apple2e/apf_stream_video_top.v, verilog/pocket_boot/build.sh
# REQUIRES: src/fpga/rtl/roms/ram_zero_64k.hex tracked (65,536 x "00", LF,
#   sha256 705ade0caf8613845b793a870707172a96aa462bfb2a878ac5fd1837f1f24c11)
#   and .gitattributes containing: *.hex text eol=lf
# Integrate with: git apply phase_b.patch  (independent of the NTSC top edits)
diff --git a/src/fpga/core/apple2e/apf_stream_video_top.v b/src/fpga/core/apple2e/apf_stream_video_top.v
index e5b8222..1385e37 100644
--- a/src/fpga/core/apple2e/apf_stream_video_top.v
+++ b/src/fpga/core/apple2e/apf_stream_video_top.v
@@ -611,9 +611,7 @@ end
 // The machine (CPU + Disk II) is in cold reset for the whole sweep
 // (reboot_ctl holds cold_reset until done + HOLD), so hijacking the RAM
 // write port is safe: apple2 and disk_ii_woz are reset-gated. The
-// initial block is the power-on state only (MIF zero-fill).
-integer ram_init_i;
-integer ram_init_j;
+// initial block is the power-on state only (file zero-fill).
 reg  [7:0]  ram_main [0:65535];
 reg  [7:0]  ram_aux  [0:65535];
 reg  [15:0] m_ram_do;
@@ -638,13 +636,20 @@ ram_sweep_ctl woz_sweep (
     .we(swp_we), .addr(swp_addr), .aux(swp_aux), .done(swp_done)
 );
 initial begin
-    // power-on RAM state (MIF zero-fill)
-    for (ram_init_i = 0; ram_init_i < 256; ram_init_i = ram_init_i + 1) begin
-        for (ram_init_j = 0; ram_init_j < 256; ram_init_j = ram_init_j + 1) begin
-            ram_main[{ram_init_i[7:0], ram_init_j[7:0]}] = 8'd0;
-            ram_aux[{ram_init_i[7:0], ram_init_j[7:0]}]  = 8'd0;
-        end
-    end
+    // power-on RAM state (file zero-fill, 2026-10-25 Phase B): the nested
+    // 256x256 procedural loop cost ~19 min of single-threaded A&S CPU on
+    // the full core (probe evidence: tools/ram_repro_init 19:13 vs
+    // tools/ram_repro_file 1:28 for the identical one-bank RAM - the file
+    // form is ~13x faster). Canonical image: src/fpga/rtl/roms/
+    // ram_zero_64k.hex (65,536 x "00", LF, git-tracked, *.hex text eol=lf).
+    // Path is CWD-relative: Quartus runs from src/fpga; the sim runner
+    // stages the same file under its rtl/roms/ (verilog/pocket_boot/
+    // build.sh, with preflight). Configuration-time initialization only -
+    // a machine reset is NOT a reload of this file: the runtime clearing
+    // sweep (ram_sweep_ctl below) still clears both banks after every
+    // cold reset before the CPU is released.
+    $readmemh("rtl/roms/ram_zero_64k.hex", ram_main);
+    $readmemh("rtl/roms/ram_zero_64k.hex", ram_aux);
 end
 // ---- the proven M1 RAM shape: plain single-port per bank, write-first
 //      bypass - consumes the overlayed _f nets only ----
diff --git a/verilog/pocket_boot/build.sh b/verilog/pocket_boot/build.sh
index 178aca1..c22faf8 100644
--- a/verilog/pocket_boot/build.sh
+++ b/verilog/pocket_boot/build.sh
@@ -40,6 +40,18 @@ cp -f "$VERILOG/u6/rtl/roms/apple2e.hex" rtl/roms/ 2>/dev/null \
 cp -f "$VERILOG/u6/rtl/roms/video2.hex"  rtl/roms/ 2>/dev/null \
     || cp -f "$ROOT/../Apple-II-Verilog_MiSTer/verilator/rtl/roms/video2.hex"  rtl/roms/
 
+# RAM zero image (the top's $readmemh init, 2026-10-25 Phase B). Canonical
+# source only, with preflight: token count + all-zero content. An empty or
+# truncated image is indistinguishable from a correct zero image in sim
+# (Verilator default-zero memory) - the preflight is the real gate.
+ZIMG="$ROOT/src/fpga/rtl/roms/ram_zero_64k.hex"
+[ -f "$ZIMG" ] || { echo "FATAL: missing $ZIMG"; exit 1; }
+zlines=$(wc -l < "$ZIMG")
+[ "$zlines" = "65536" ] || { echo "FATAL: ram_zero_64k.hex has $zlines lines (want 65536)"; exit 1; }
+zbad=$(grep -cv '^00$' "$ZIMG" || true)
+[ "$zbad" = "0" ] || { echo "FATAL: ram_zero_64k.hex has $zbad non-zero/invalid lines"; exit 1; }
+cp -f "$ZIMG" rtl/roms/
+
 # APF templates mf_pllbase.v (core/) and mf_datatable.v (apf/) declare
 # `timescale 1ps/1ps`; a ps-timescale file poisons Verilator's
 # mixed-timescale delay handling for the whole model (ns delays in the other
